<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <!-- Иконка приложения -->
        <file alias="app-icon.png">icons/app-icon.png</file>
        
        <!-- Иконки управления воспроизведением -->
        <file alias="play.png">icons/play.png</file>
        <file alias="pause.png">icons/pause.png</file>
        <file alias="stop.png">icons/stop.png</file>
        <file alias="next.png">icons/next.png</file>
        <file alias="previous.png">icons/previous.png</file>
        
        <!-- Иконки интерфейса -->
        <file alias="folder.png">icons/folder.png</file>
        <file alias="add.png">icons/add.png</file>
        <file alias="remove.png">icons/remove.png</file>
        <file alias="settings.png">icons/settings.png</file>
        
        <!-- Иконки комнат -->
        <file alias="room-create.png">icons/room-create.png</file>
        <file alias="room-join.png">icons/room-join.png</file>
        <file alias="room-leave.png">icons/room-leave.png</file>
        
        <!-- Иконки статуса -->
        <file alias="connected.png">icons/connected.png</file>
        <file alias="disconnected.png">icons/disconnected.png</file>
        <file alias="sync.png">icons/sync.png</file>
    </qresource>
</RCC>
