# EditorConfig for TorrSyncPlayer
# https://editorconfig.org/

root = true

# ── Universal settings ───────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ── Go files ─────────────────────────────────────────────────────────────
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# ── C++ files ────────────────────────────────────────────────────────────
[*.{cpp,h,hpp}]
indent_style = space
indent_size = 4

# ── CMake ────────────────────────────────────────────────────────────────
[CMakeLists.txt]
indent_style = space
indent_size = 4

# ── Makefile ─────────────────────────────────────────────────────────────
[Makefile]
indent_style = tab

# ── JSON ─────────────────────────────────────────────────────────────────
[*.json]
indent_style = space
indent_size = 2

# ── YAML ─────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# ── BAT scripts ─────────────────────────────────────────────────────────
[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 4

# ── Markdown ─────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
