# TorrSyncPlayer — Environment variables example

## Server Configuration
PORT=8889
LOG_LEVEL=info
LOG_FORMAT=text
# Directory for persistent data (defaults to ./data; set empty to disable persistence)
DATA_DIR=./data

## Security
# There is no secret to configure. The server generates a random access token at
# every start and prints it to the console; clients must present it in the
# X-Access-Token header. Nothing is persisted and nothing is registered.
# Room passwords are supplied per room via the API, not here.

## CORS
# For production, explicitly set allowed origins
CORS_ORIGINS=http://localhost:8889,http://127.0.0.1:8889

## TLS (optional)
TLS_CERT=
TLS_KEY=

## Storage
# Maximum in-memory storage size in bytes (0 = unlimited, max 256GB).
# Default when unset: 4GB (constants.DefaultMemoryStorageCapacity).
MEMORY_CAPACITY=4294967296
# Persist torrent pieces to disk under DATA_DIR (DATA_DIR defaults to ./data).
# When false (default), torrent pieces are kept in memory only.
DISK_STORAGE=false

## Environment
ENV=development
# GO_ENV is read as an alternative to ENV for production detection
GO_ENV=

## Proxy
# TRUSTED_PROXIES: comma-separated CIDR ranges of reverse proxies whose
# X-Forwarded-For / X-Real-IP headers may be believed.
# When unset, NO proxy is trusted and those headers are ignored — a client can
# otherwise forge its apparent IP to evade per-IP rate limiting.
# Set this only if you actually run behind a proxy, e.g. TRUSTED_PROXIES=127.0.0.1/32
TRUSTED_PROXIES=
