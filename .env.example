# TorrSyncPlayer — Пример переменных окружения

## Server Configuration
PORT=8889
LOG_LEVEL=info
LOG_FORMAT=text

## Security (ОБЯЗАТЕЛЬНО для production)
# JWT_SECRET должен быть не менее 32 символов
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here-min-32-chars

## CORS
# Для production обязательно укажите разрешённые origins
CORS_ORIGINS=http://localhost:8889,http://127.0.0.1:8889

## TLS (опционально)
TLS_CERT=
TLS_KEY=

## Storage
MEMORY_CAPACITY=536870912

## Environment
ENV=development
