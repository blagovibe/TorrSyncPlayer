# TorrSyncPlayer — Environment variables example

## Server Configuration
PORT=8889
LOG_LEVEL=info
LOG_FORMAT=text
# Directory for persistent data (empty = in-memory only)
DATA_DIR=./data

## Security
# WARNING: Change this value immediately in production!
# Do NOT use the default value shown below.
# Use this env var instead of -jwt-secret flag for security
JWT_SECRET=your-very-long-and-secure-jwt-secret-key-here-min-32-chars

## CORS
# For production, explicitly set allowed origins
CORS_ORIGINS=http://localhost:8889,http://127.0.0.1:8889

## TLS (optional)
TLS_CERT=
TLS_KEY=

## Storage
# Maximum in-memory storage size in bytes (0 = unlimited, max 256GB)
MEMORY_CAPACITY=536870912

## Environment
ENV=development
# GO_ENV is read as an alternative to ENV for production detection
GO_ENV=

## Proxy
# TRUSTED_PROXIES: comma-separated CIDR ranges for trusted reverse proxies
# If not set, defaults to private/loopback/link-local ranges
TRUSTED_PROXIES=
