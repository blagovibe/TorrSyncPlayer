# TorrSyncPlayer — Environment variables example

## Server Configuration
PORT=8889
LOG_LEVEL=info
LOG_FORMAT=text
# Directory for persistent data (defaults to ./data; set empty to disable persistence)
DATA_DIR=./data

## Security
# WARNING: You MUST set your own secret (min 32 bytes) before running the server.
# The server REFUSES TO START with an empty or too-short JWT_SECRET.
# Use this env var instead of -jwt-secret flag for security.
# Leave empty to be reminded at startup that a secret is required.
JWT_SECRET=

## JWT
# JWT token lifetime in hours (default 24).
JWT_TTL_HOURS=24

## CORS
# For production, explicitly set allowed origins
CORS_ORIGINS=http://localhost:8889,http://127.0.0.1:8889

## TLS (optional)
TLS_CERT=
TLS_KEY=

## Storage
# Maximum in-memory storage size in bytes (0 = unlimited, max 256GB).
# Default when unset: 4GB (constants.DefaultMemoryStorageCapacity).
MEMORY_CAPACITY=4294967296
# Persist torrent pieces to disk under DATA_DIR (DATA_DIR defaults to ./data).
# When false (default), torrent pieces are kept in memory only.
DISK_STORAGE=false

## Environment
ENV=development
# GO_ENV is read as an alternative to ENV for production detection
GO_ENV=

## Proxy
# TRUSTED_PROXIES: comma-separated CIDR ranges for trusted reverse proxies
# If not set, defaults to private/loopback/link-local ranges
TRUSTED_PROXIES=
