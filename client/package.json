{
  "name": "torrsyncplayer",
  "private": true,
  "version": "0.1.8",
  "description": "Sync video playback via torrent-backed media sharing.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "build": "tsc && vite build",
    "electron:build": "npm run build && node scripts/prepare-electron-app.cjs && electron-builder --projectDir .electron-app --publish never",
    "electron:build:linux": "npm run build && node scripts/prepare-electron-app.cjs && electron-builder --projectDir .electron-app --linux AppImage --publish never",
    "electron:build:win": "npm run build && node scripts/prepare-electron-app.cjs && electron-builder --projectDir .electron-app --win nsis portable --publish never",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH vitest run --pool=forks --poolOptions.forks.singleFork --no-file-parallelism --passWithNoTests",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:win": "tauri build --no-bundle --ci",
    "tauri:build:linux": "tauri build --bundles appimage --ci"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webtorrent": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "crypto-browserify": "^3.12.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "events": "^3.3.0",
    "globals": "^15.15.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "util": "^0.12.5",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.6"
  }
}
