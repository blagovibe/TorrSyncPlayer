{
  "name": "torrsyncplayer",
  "private": true,
  "version": "0.1.21",
  "description": "Sync video playback via torrent-backed media sharing.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "build": "tsc && vite build",
    "electron:build": "npm run build && node scripts/prepare-electron-app.cjs && electron-builder --projectDir .electron-app",
    "electron:build:linux": "npm run build && node scripts/prepare-electron-app.cjs && electron-builder --projectDir .electron-app --linux AppImage",
    "electron:build:win": "npm run build && node scripts/prepare-electron-app.cjs && electron-builder --projectDir .electron-app --win portable -c.win.signAndEditExecutable=false --publish never",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork --no-file-parallelism --passWithNoTests",
    "test:electron": "vitest run --project=electron --no-file-parallelism --passWithNoTests",
    "preview": "vite preview"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "webtorrent": "3.0.13"
  },
  "overrides": {
    "ip": "2.0.1",
    "tmp": "^0.2.6",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "events": "^3.3.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "util": "^0.12.5",
    "vite": "^6.4.2",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.6"
  }
}
