{
  "name": "client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "PATH=/usr/bin:/bin:/usr/sbin:/sbin:$PATH vitest run --pool=forks --poolOptions.forks.singleFork --no-file-parallelism --passWithNoTests",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build:win": "tauri build --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webtorrent": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "events": "^3.3.0",
    "globals": "^15.15.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "util": "^0.12.5",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
