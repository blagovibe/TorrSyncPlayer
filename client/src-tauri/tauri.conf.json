{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorrSyncPlayer",
  "version": "0.1.1",
  "identifier": "com.torrsyncplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TorrSyncPlayer",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "targets": ["appimage", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Sync video via torrent",
    "longDescription": "TorrSyncPlayer is a desktop app for synchronized video playback using torrent-backed media sharing.",
    "category": "Video",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
