{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorrSyncPlayer",
  "version": "0.1.0",
  "identifier": "com.torrsyncplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TorrSyncPlayer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "targets": ["appimage", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Sync video via torrent",
    "longDescription": "TorrSyncPlayer is a desktop app for synchronized video playback using torrent-backed media sharing.",
    "category": "Video"
  }
}
